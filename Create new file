<!DOCTYPE html>
<html>
<head>
    <title>台股監測 v17.0</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        body { font-family: sans-serif; background: #f4f4f9; text-align: center; padding: 20px; }
        .card { background: white; border-radius: 15px; padding: 20px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
        .btn { background: #1a5276; color: white; border: none; padding: 15px 30px; border-radius: 10px; font-size: 18px; cursor: pointer; }
        .status { margin-top: 20px; color: #666; }
    </style>
</head>
<body>
    <div class="card">
        <h1>📈 台股監測 App</h1>
        <p>目前持股：26 檔成分股</p>
        <button class="btn" onclick="runWorkflow()">🚀 開始更新並計算</button>
        <div id="status" class="status">點擊按鈕啟動雲端運算</div>
    </div>

    <script>
        function runWorkflow() {
            // 這裡會引導您去點擊 Actions 執行，
            // 因為 GitHub 的安全性限制，直接從網頁觸發需要權杖(Token)，初學者建議先點擊跳轉。
            document.getElementById('status').innerText = '正在跳轉至雲端執行頁面...';
            window.location.href = 'https://github.com/您的帳號/stock-monitor/actions';
        }
    </script>
</body>
</html>
